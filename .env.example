DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id

# Optional: commands register immediately in this server.
# Leave empty to register globally.
DISCORD_GUILD_ID=

# Optional administrator configuration.
DISCORD_OWNER_ID=
BOT_ADMIN_ROLE_ID=

# BazaarLink Configuration (OpenAI-compatible API)
BAZAARLINK_API_KEY=your_bazaarlink_api_key
BAZAARLINK_MODEL=auto:free

# TinyFish Configuration (optional, for web/search capabilities)
TINYFISH_API_KEY=your_tinyfish_api_key

DB_PATH=./data/evon.sqlite
